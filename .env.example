# ================================================================
# FRONTEND ENVIRONMENT VARIABLES (EXAMPLE / TEMPLATE)
# ================================================================
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# NEVER commit the real `.env` file. See .gitignore.
#
# ⚠️  SECURITY NOTE:
#     Every variable prefixed with VITE_ is embedded into the PUBLIC
#     browser bundle. Never put true secrets (API secrets, private
#     tokens) behind a VITE_ variable.
# ================================================================

# ----------------------------------------------------------------
# Domain & API
# ----------------------------------------------------------------
# Primary domain (no protocol). Used for canonical / OG / JSON-LD URLs.
VITE_DOMAIN=example.com
# Backend API base URL.
VITE_API_BASE_URL=http://localhost:4000/api

# ----------------------------------------------------------------
# Branding & Owner Identity
# ----------------------------------------------------------------
VITE_BRAND_NAME=FIQTOR
VITE_OWNER_NAME="Your Name"
VITE_OWNER_ALIAS=FIQTOR
VITE_OWNER_JOB_TITLE="Software Engineer"
VITE_OWNER_HEADLINE="An engineer building full stack web applications, AI automation, and business systems."
VITE_OWNER_YEARS_EXPERIENCE=0
VITE_OWNER_COUNTRY=Indonesia
VITE_OWNER_COUNTRY_CODE=ID
# Comma separated list
VITE_OWNER_LANGUAGES="English,Bahasa Indonesia"
# Portrait image path served from /public
VITE_PORTRAIT_IMAGE=/icon.webp

# ----------------------------------------------------------------
# Contact Information
# ----------------------------------------------------------------
VITE_CONTACT_EMAIL=contact@example.com
VITE_CONTACT_BUSINESS_EMAIL=business@example.com
# Public phone number (E.164), e.g. +6281234567890
VITE_CONTACT_PHONE=""
# WhatsApp number in international format WITHOUT "+", e.g. 6281234567890
VITE_CONTACT_WHATSAPP=""
# X / Twitter handle including "@"
VITE_TWITTER_HANDLE="@yourhandle"

# ----------------------------------------------------------------
# Social Profiles (full URLs)
# ----------------------------------------------------------------
VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/yourhandle/
VITE_SOCIAL_TIKTOK=https://www.tiktok.com/@yourhandle
VITE_SOCIAL_YOUTUBE=https://www.youtube.com/@yourhandle
VITE_SOCIAL_LINKEDIN=https://www.linkedin.com/in/yourhandle
VITE_SOCIAL_GITHUB=https://github.com/yourhandle
VITE_SOCIAL_THREADS=https://www.threads.net/@yourhandle

# ----------------------------------------------------------------
# Resume Files (served from /public/pdf)
# Replace the files in frontend/public/pdf and update these paths.
# ----------------------------------------------------------------
VITE_RESUME_CREATIVE_EN=/pdf/Taufiiqul_Hakim-Creative_Resume-en.pdf
VITE_RESUME_CREATIVE_ID=/pdf/Taufiiqul_Hakim-Creative_Resume-id.pdf
VITE_RESUME_ATS_EN=/pdf/Taufiiqul_Hakim-Resume-en.pdf
VITE_RESUME_ATS_ID=/pdf/Taufiiqul_Hakim-Resume-id.pdf

# ----------------------------------------------------------------
# Integration Usernames
# ----------------------------------------------------------------
# These public usernames now live in `src/config/*.ts` instead of env:
#   - src/config/Github.ts    → GitHub username
#   - src/config/Wakatime.ts  → WakaTime username
#   - src/config/Instagram.ts → Instagram username
#   - src/config/Tiktok.ts    → TikTok username
# Edit those files to change the usernames.

# ----------------------------------------------------------------
# Google reCAPTCHA v2 — https://www.google.com/recaptcha/admin/create
# Only the SITE key may live on the client. Keep the SECRET on the backend.
# ----------------------------------------------------------------
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# ----------------------------------------------------------------
# Company / Business Brand (optional — used on services & linktree)
# ----------------------------------------------------------------
VITE_COMPANY_NAME=IARTY
VITE_COMPANY_URL=https://iarty.biz.id
VITE_COMPANY_AI_URL=https://ai.iarty.biz.id
VITE_COMPANY_EDUCATION_URL=https://education.iarty.biz.id
VITE_COMPANY_MARKETPLACE_URL=https://marketplace.iarty.biz.id
VITE_COMPANY_TEMPLATES_URL=https://iarty.biz.id/templates
VITE_COMPANY_IMAGE=/img/iarty.webp

# ----------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------
VITE_ENABLE_AI=TRUE

# ----------------------------------------------------------------
# Analytics (optional)
# Google Analytics measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable.
# ----------------------------------------------------------------
VITE_GA_MEASUREMENT_ID=
