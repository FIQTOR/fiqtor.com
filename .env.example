# ================================================================
# FRONTEND ENVIRONMENT VARIABLES (EXAMPLE / TEMPLATE)
# ================================================================
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# NEVER commit the real `.env` file. See .gitignore.
#
# ⚠️  SECURITY NOTE:
#     Every variable prefixed with VITE_ is embedded into the PUBLIC
#     browser bundle. Never put true secrets (API secrets, private
#     tokens) behind a VITE_ variable.
#
# ℹ️  Branding/identity is NO LONGER in env — it is code-based:
#       - src/config/Identity.ts   → brand, owner, contact, social URLs,
#                                    resume paths, company, site origin, GA ID
#       - src/config/Github.ts     → GitHub username
#       - src/config/Wakatime.ts   → WakaTime username
#       - src/config/Instagram.ts  → Instagram username
#       - src/config/Tiktok.ts     → TikTok username
#     Crypto prices & social stats are served by the backend (static data).
# ================================================================

# ----------------------------------------------------------------
# Domain & API
# ----------------------------------------------------------------
# Optional site-origin override (no protocol). Used for canonical / OG /
# JSON-LD URLs. Defaults to SITE_ORIGIN in src/config/Identity.ts.
VITE_DOMAIN=example.com
# Backend API base URL.
VITE_API_BASE_URL=http://localhost:4000/api

# ----------------------------------------------------------------
# Google reCAPTCHA v2 — https://www.google.com/recaptcha/admin/create
# Only the SITE key may live on the client. Keep the SECRET on the backend.
# ----------------------------------------------------------------
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# ----------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------
VITE_ENABLE_AI=TRUE
