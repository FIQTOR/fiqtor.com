# ================================================================
# FRONTEND ENVIRONMENT VARIABLES (TEMPLATE)
# ================================================================
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
# NEVER commit the real `.env`. See .gitignore.
#
# SECURITY: every VITE_* variable is embedded into the PUBLIC browser
# bundle. Never put secrets (API keys, tokens) behind a VITE_ variable.
#
# Identity / branding is code-based (no env needed):
#   src/config/Identity.ts  → brand, owner, contact, social URLs, resume paths
# ================================================================

# ----- Domain & API ------------------------------------------------
# Optional site-origin override (protocol optional) used for canonical /
# OpenGraph / JSON-LD URLs. Defaults to SITE_ORIGIN in src/config/Identity.ts.
VITE_DOMAIN=fiqtor.com

# Backend API base URL, e.g. https://api.fiqtor.com/api
# Powers: AI chat, contact form, GitHub, WakaTime, crypto, social stats.
VITE_API_BASE_URL=http://localhost:4000/api

# ----- Google reCAPTCHA v2 (site key only) ------------------------
# Leave empty to disable the widget (the backend still validates + rate limits).
VITE_RECAPTCHA_SITE_KEY=

# ----- Feature flags ---------------------------------------------
# Set to false to hide the AI assistant button entirely.
VITE_ENABLE_AI=TRUE

# ----- Google Analytics 4 -----------------------------------------
# Defaults to GA_MEASUREMENT_ID in src/config/Identity.ts, which is the
# production property. Set to a DIFFERENT valid G-… id to override.
# NOTE: empty (or a non-G-… value) falls back to GA_MEASUREMENT_ID, it does
# NOT disable analytics. To disable analytics, set GA_MEASUREMENT_ID = '' in
# src/config/Identity.ts.
VITE_GA_ID=
